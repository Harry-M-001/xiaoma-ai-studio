# ===== 小马AI工坊 环境配置示例 =====
# 复制本文件为 .env 后按需修改；不配置任何内容也可以直接启动（默认仅本机访问）。

# 数据目录（SQLite 数据库、本地产物文件都在这里），默认 backend/data
# DATA_DIR=./data

# 监听地址与端口。默认只监听本机；如需局域网访问改为 0.0.0.0
HOST=127.0.0.1
PORT=8787

# 可选：设置后打开网页需要输入该口令才能使用；留空则免登录（适合纯本机使用）
APP_PASSWORD=

# 前端构建产物目录（一般不需要改；Docker 内已固定）
# FRONTEND_DIST=../frontend/dist

# 调用模型接口的默认超时时间（秒）
REQUEST_TIMEOUT=300
